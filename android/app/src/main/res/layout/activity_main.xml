<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#181818"
    tools:context=".PoseDetectionActivity">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewCam"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.ooplab.exercises_fitfuel.PoseOverlayView
        android:id="@+id/poseOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Level / horizon indicator, centred on the camera preview -->
    <com.ooplab.exercises_fitfuel.CameraLevelView
        android:id="@+id/cameraLevel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/previewCam"
        app:layout_constraintBottom_toBottomOf="@id/previewCam"
        app:layout_constraintStart_toStartOf="@id/previewCam"
        app:layout_constraintEnd_toEndOf="@id/previewCam" />

    <!-- Capture sequence cue — visible during POSE phase once the multi-shot
         capture sequence starts; tells the phone holder what's happening. -->
    <TextView
        android:id="@+id/tvCaptureStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="14sp"
        android:gravity="center"
        android:background="#CC1A1A1A"
        android:paddingHorizontal="18dp"
        android:paddingVertical="10dp"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/statusPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- All status conditions in one column, in order:
         Light, Person, Monitor, Rotation, Tilt, Distance, Side -->
    <LinearLayout
        android:id="@+id/statusPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvLightStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Light"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:background="#AA000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvPersonStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Person"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:background="#AA000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvMonitorStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Monitor"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:background="#AA000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvRotationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Rotation  --"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:background="#AA000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvTiltStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Tilt  --°"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:background="#AA000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDistanceStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Distance  --"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:background="#AA000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvSideViewStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Side  --"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:background="#AA000000"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:layout_marginBottom="4dp" />

        <!-- Confirmation progress — appears when both person + monitor detected -->
        <ProgressBar
            android:id="@+id/confirmProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:max="4"
            android:progress="0"
            android:progressTint="#43A047"
            android:progressBackgroundTint="#33FFFFFF"
            android:visibility="invisible" />

        <!-- General status message: light guidance, "Hold still...", "Loading..." -->
        <TextView
            android:id="@+id/tvStatusMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#CCFFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:visibility="gone" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnSwitchCamera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="66dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle_translucent"
        android:src="@drawable/ic_switch_camera"
        android:scaleType="centerInside"
        android:padding="12dp"
        android:contentDescription="Switch camera"
        app:tint="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Shutter flash — brief white flash overlay fired on each capture -->
    <View
        android:id="@+id/flashOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFFFFF"
        android:alpha="0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
